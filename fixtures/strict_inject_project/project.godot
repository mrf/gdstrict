; Hostile fixture for godot-linter-phase3-strict-6zk.1 — strict warning injection.
; This project ACTIVELY DISABLES every warning in gdstrict's strict set. gdstrict must
; surface those warnings anyway by injecting its own override.cfg, proving it does
; not trust the target project's [debug] config.
;
; The key list below must mirror STRICT_WARNINGS in crates/gdstrict-strict/src/lib.rs
; (all set to 0 here). The `inject_fixture_disables_every_strict_warning` test fails if
; they drift.

config_version=5

[application]

config/name="gdstrict-strict-inject-fixture"
config/features=PackedStringArray("4.6")

[debug]

gdscript/warnings/enable=true
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
